// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "flatbuffers ocaml devcontainer",
    "build":  {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        "./features/ocaml": {
            "version": "${localEnv:OCAML_VERSION}",
            "base-packages": "dune ocaml-lsp-server",
            "packages": "alcotest benchmark bigstringaf cppo js_of_ocaml js_of_ocaml-compiler js_of_ocaml-ppx memtrace",
            "optional-packages": "ocamlformat.0.29.0 ocamlformat-rpc melange"
        },
        "./features/gh": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ocamllabs.ocaml-platform",
                "github.vscode-github-actions",
                "github.vscode-pull-request-github"
            ]
        }
    },
    "remoteUser": "vscode",
    "postCreateCommand": {
	"submodules": "git submodule update --init --depth 1",
        "opam": "sudo .devcontainer/fix-opam-owner.sh $(id -u) $(id -g)"
    },
    "waitFor": "postCreateCommand"
}
