namespace UnionVector;

table Sword {
  damage:int;
}

table Spell {
  name:string;
}

struct Point {
  x:int;
  y:int;
}

union Item { Sword, Spell, Label:string, Point }

table Inventory {
  items:[Item];
  required_items:[Item] (required);
  featured:Item;
}

root_type Inventory;
file_identifier "UVEC";
